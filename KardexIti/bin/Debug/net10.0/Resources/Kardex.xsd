<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kardex.xsd
  Esquema del expediente académico del Instituto Tecnológico (ITI).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- ===================== Tipos simples ===================== -->

  <!-- Periodo escolar: ENE-JUN-AAAA o AGO-DIC-AAAA. -->
  <xs:simpleType name="TipoPeriodo">
    <xs:restriction base="xs:string">
      <xs:pattern value="(ENE-JUN|AGO-DIC)-\d{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Número de control de 8 dígitos:
      - 2 dígitos del año de ingreso (19, 20, 21, 22, ...)
      - 67, código obligatorio del tecnológico
      - 4 dígitos consecutivos de 0000 a 0400
  -->
  <xs:simpleType name="TipoNumeroControl">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d{2}67(0[0-3]\d{2}|0400)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoNombreCompleto">
    <xs:restriction base="xs:string">
      <xs:minLength value="5"/>
      <xs:maxLength value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoCarrera">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Ingeniería en Informática"/>
      <xs:enumeration value="Ingeniería en Sistemas Computacionales"/>
      <xs:enumeration value="Ingeniería Industrial"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoSemestre">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="9"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Clave de materia: tres letras, guion y cuatro dígitos (ej. IFD-1010). -->
  <xs:simpleType name="TipoClaveMateria">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{3}-\d{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoNombreMateria">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoCreditos">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="6"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoCalificacion">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0"/>
      <xs:maxInclusive value="100.0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================== Tipos complejos ===================== -->

  <xs:complexType name="TipoMateria">
    <xs:sequence>
      <xs:element name="NombreMateria" type="TipoNombreMateria"/>
      <xs:element name="Creditos"      type="TipoCreditos"/>
      <xs:element name="Calificacion"  type="TipoCalificacion"/>
      <xs:element name="Aprobada"      type="xs:boolean"/>
    </xs:sequence>
    <xs:attribute name="clave" type="TipoClaveMateria" use="required"/>
  </xs:complexType>

  <xs:complexType name="TipoMaterias">
    <xs:sequence>
      <xs:element name="Materia" type="TipoMateria" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== Elemento raíz ===================== -->

  <xs:element name="ExpedienteAcademico">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NumeroControl"  type="TipoNumeroControl"/>
        <xs:element name="NombreCompleto" type="TipoNombreCompleto"/>
        <xs:element name="Carrera"        type="TipoCarrera"/>
        <xs:element name="Semestre"       type="TipoSemestre"/>
        <xs:element name="Materias"       type="TipoMaterias"/>
      </xs:sequence>
      <xs:attribute name="periodo" type="TipoPeriodo" use="required"/>
    </xs:complexType>

    <!-- La clave de cada materia no se puede repetir dentro del expediente. -->
    <xs:unique name="ClaveMateriaUnica">
      <xs:selector xpath="Materias/Materia"/>
      <xs:field xpath="@clave"/>
    </xs:unique>
  </xs:element>

</xs:schema>
